# systemd unit for a Ferrix app (here the reference app, todo-server, built by scripts/release.sh).
#
#   sudo install -m 0755 dist/todo-server /usr/local/bin/todo-server
#   sudo install -m 0644 deploy/ferrix.service /etc/systemd/system/ferrix.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now ferrix
#   journalctl -u ferrix -f                         # the setup link for the first admin is printed here
#
# The data lives in /var/lib/ferrix (StateDirectory); the service runs as a dynamic, unprivileged user.
# Run CLI commands on the same data as that user, e.g. a backup while it runs:
#   sudo systemd-run --pipe --wait -p DynamicUser=yes -p StateDirectory=ferrix \
#     /usr/local/bin/todo-server backup --dir /var/lib/ferrix
# Restores: from the dashboard (Backups, "Restore": validated while the server runs, applied when it restarts; the
# "Restart now" button exits with code 75, which systemd restarts below), or offline: `systemctl stop ferrix`,
# `todo-server restore <archive> --dir /var/lib/ferrix` (as above),
# `systemctl start ferrix`.

[Unit]
Description=Ferrix app (todo-server)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Behind a reverse proxy (Caddy, nginx) that terminates TLS:
ExecStart=/usr/local/bin/todo-server serve --http 127.0.0.1:8090 --dir /var/lib/ferrix --public-url https://example.com
# Or HTTPS directly with Let's Encrypt (ports 443 and 80; needs the capability below):
#ExecStart=/usr/local/bin/todo-server serve --https example.com --acme-email you@example.com --dir /var/lib/ferrix
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Secrets and settings (FERRIX_SMTP_URL, AWS_* for S3 storage or backups, FERRIX_METRICS_TOKEN, ...):
EnvironmentFile=-/etc/ferrix/env
Environment=RUST_LOG=info
# Logs are JSON lines (not a terminal); `journalctl -u ferrix -o cat | jq` reads them. FERRIX_LOG_FORMAT=pretty for text.
# Lets an administrator restart the service from the dashboard to apply a staged restore (exit code 75, restarted
# by RestartForceExitStatus below).
Environment=FERRIX_RESTART_EXIT_CODE=75
# Scheduled backups, e.g. every 6 hours to S3, keeping 28:
#Environment=FERRIX_BACKUP_TO=s3://my-bucket/backups
# (and add `--backup-every 6h --backup-keep 28` to ExecStart)

# SIGTERM stops gracefully: no new connections, open requests finish.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2
RestartForceExitStatus=75
LimitNOFILE=65536

DynamicUser=yes
StateDirectory=ferrix
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ferrix
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
