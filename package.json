{
  "name": "rxferrix-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*/web",
    "docs"
  ],
  "scripts": {
    "build": "bun run --filter @rxferrix/client build && bun run --filter @rxferrix/react build && bun run --filter @rxferrix/svelte build",
    "typecheck": "bun run --filter @rxferrix/client build && bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build:dashboard": "bun run --filter @rxferrix/dashboard build",
    "check:dashboard": "bun run --filter @rxferrix/dashboard check:dist",
    "docs:dev": "bun run --filter @rxferrix/docs dev",
    "docs:build": "bun run --filter @rxferrix/docs build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "jsdom": "^30.1.2"
  }
}
