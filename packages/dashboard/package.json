{
  "name": "@rxferrix/dashboard",
  "version": "0.6.0",
  "private": true,
  "description": "The RxFerrix admin dashboard (Svelte 5 SPA), embedded into the rxferrix crate and served at /_/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun scripts/source-hash.ts --write",
    "check:dist": "bun scripts/source-hash.ts --check",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "e2e": "bun e2e/dashboard.ts"
  },
  "dependencies": {
    "@rxferrix/client": "workspace:*",
    "@rxferrix/svelte": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
