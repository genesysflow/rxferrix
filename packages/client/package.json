{
  "name": "@rxferrix/client",
  "version": "0.6.1",
  "description": "Framework-agnostic reactive sync client for RxFerrix",
  "license": "MIT",
  "homepage": "https://genesysflow.github.io/rxferrix/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesysflow/rxferrix.git",
    "directory": "packages/client"
  },
  "keywords": [
    "rxferrix",
    "reactive",
    "realtime",
    "websocket"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
