{
  "name": "@rxferrix/react",
  "version": "0.9.0",
  "description": "React hooks for RxFerrix",
  "license": "MIT",
  "homepage": "https://genesysflow.github.io/rxferrix/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genesysflow/rxferrix.git",
    "directory": "packages/react"
  },
  "keywords": [
    "rxferrix",
    "reactive",
    "realtime",
    "websocket",
    "react"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@rxferrix/client": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
